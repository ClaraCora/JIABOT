# ==========================================
# 家宽 VPS Telegram 运维机器人配置模板
# 复制本文件为 .env 并填写相应参数
# ==========================================

# 1. Telegram Bot 基本配置
# 从 Telegram 官方 @BotFather 申请获得的 Bot Token
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 允许使用机器人的 Telegram 用户 ID 列表，支持多个，英文逗号分隔
# 可向 @userinfobot 发送消息获取您的 Telegram Numeric ID
ALLOWED_USER_IDS=123456789,987654321

# 2. VPS API 接口配置 (默认已预配置 boil.network)
# 您的 VPS API Token (在此填入您的 Token 即可，机器人会自动以 Bearer 方式鉴权)
VPS_API_TOKEN=your_vps_token_here

# 查询 IP 接口配置 (已默认适配 boil.network)
VPS_QUERY_IP_URL=https://ippanel.boil.network/api/v1/getIP
VPS_QUERY_IP_METHOD=POST

# 更换 IP 接口配置 (已默认适配 boil.network)
VPS_CHANGE_IP_URL=https://ippanel.boil.network/api/v1/changeIP/
VPS_CHANGE_IP_METHOD=POST

# 高级选项：自定义参数与请求头（一般情况下无需修改）
VPS_CHANGE_IP_PARAMS=
VPS_CHANGE_IP_HEADERS=

# 本地命令模式 (如非 API 而是本地 PPPoE 重拨时才需要填写)
# VPS_CHANGE_IP_COMMAND=poff -a && sleep 2 && pon dsl-provider
VPS_CHANGE_IP_COMMAND=

# 3. xykt/IPQuality 脚本检测与调度配置
# 定时体检时间点（24小时制，多个时间用英文逗号分隔，默认每天 09:00 与 21:00 各测试一次）
IPQUALITY_CRON_TIMES=09:00,21:00

# 定时任务调度时区（默认 Asia/Shanghai，确保海外/UTC VPS 也能在准确时间触发）
TIMEZONE=Asia/Shanghai

# 更换 IP 成功后，是否自动触发一次 IPQuality 质量体检（true / false）
AUTO_TEST_ON_IP_CHANGE=true

# IPQuality 脚本执行超时时间（单位：秒，防止脚本网络卡顿，默认 300 秒）
IPQUALITY_TEST_TIMEOUT=300

# IPQuality 脚本源地址 (默认使用官方极速源)
IPQUALITY_SCRIPT_URL=https://IP.Check.Place

# 4. 系统与数据存储配置
# 数据持久化目录（存放 latest_record.json 与 历史记录）
DATA_DIR=./data
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
