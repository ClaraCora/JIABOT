[Unit]
Description=Home Broadband VPS Telegram Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/JIABOT
User=root
# 虚拟环境中的 python 路径
ExecStart=/root/JIABOT/venv/bin/python main.py
Restart=always
RestartSec=10
# 环境变量
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
