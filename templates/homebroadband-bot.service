[Unit]
Description=Home Broadband VPS Telegram Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# 建议指定运行目录与用户 (请根据实际部署路径修改)
WorkingDirectory=/root/家宽BOT
User=root
# 建议指定虚拟环境中的 python 路径
ExecStart=/root/家宽BOT/venv/bin/python main.py
Restart=always
RestartSec=10
# 环境变量
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
